{"qid": "it_passport-0906", "examId": "it_passport", "levelId": "standard", "subjectId": "business", "topicId": "organization", "prompt": "ROE（自己資本利益率）を求める式として適切なものはどれか。", "choices": ["当期純利益 ÷ 自己資本 × 100", "当期純利益 ÷ 売上高 × 100", "売上高 ÷ 自己資本 × 100", "当期純利益 ÷ 総資産 × 100"], "answerIndex": 0, "explanation": "ROEは当期純利益を自己資本で割り、100を掛けた百分率で表す。", "difficulty": 4, "points": 1, "source": "original", "sourceRef": "自作（ITパスポート試験 新シラバス案 Ver.0.1 の範囲に該当する一般的な基礎知識）", "contentVer": "2026.10.2", "subtopicId": "business-organization"}
{"qid": "it_passport-0907", "examId": "it_passport", "levelId": "standard", "subjectId": "business", "topicId": "organization", "prompt": "ROA（総資産利益率）を求める式として適切なものはどれか。", "choices": ["流動資産 ÷ 流動負債 × 100", "売上高 ÷ 総資産 × 100", "当期純利益 ÷ 総資産 × 100", "当期純利益 ÷ 自己資本 × 100"], "answerIndex": 2, "explanation": "ROAは、総資産をどれだけ効率的に使って利益を出したかを示す。", "difficulty": 4, "points": 1, "source": "original", "sourceRef": "自作（ITパスポート試験 新シラバス案 Ver.0.1 の範囲に該当する一般的な基礎知識）", "contentVer": "2026.10.2", "subtopicId": "business-organization", "conceptId": "it_passport_term-0443", "angle": "definition"}
{"qid": "it_passport-0908", "examId": "it_passport", "levelId": "standard", "subjectId": "business", "topicId": "organization", "prompt": "総資産が1,000万円、当期純利益が50万円のとき、ROAはいくらか。", "choices": ["50%", "0.5%", "10%", "5%"], "answerIndex": 3, "explanation": "ROA = 50 ÷ 1,000 × 100 = 5%である。", "difficulty": 4, "points": 1, "source": "original", "sourceRef": "自作（ITパスポート試験 新シラバス案 Ver.0.1 の範囲に該当する一般的な基礎知識）", "contentVer": "2026.10.2", "subtopicId": "business-organization", "conceptId": "it_passport_term-0443", "angle": "scenario"}
