{"qid": "it_passport-0906", "examId": "it_passport", "levelId": "standard", "subjectId": "business", "topicId": "organization", "prompt": "ROE（自己資本利益率）を、求める式として、適切なものはどれか。", "choices": ["売上高 × 利益率", "総資産 ÷ 売上高", "売上高 ÷ 総資産", "当期純利益 ÷ 自己資本 × 100"], "answerIndex": 3, "explanation": "ROE = 当期純利益 ÷ 自己資本 × 100（%）。", "difficulty": 4, "points": 1, "source": "original", "sourceRef": "自作（ITパスポート試験 新シラバス案 Ver.0.1 の範囲に該当する一般的な基礎知識）", "contentVer": "2026.10.1", "subtopicId": "business-organization"}
{"qid": "it_passport-0907", "examId": "it_passport", "levelId": "standard", "subjectId": "business", "topicId": "organization", "prompt": "ROA（総資産利益率）を、求める式として、適切なものはどれか。", "choices": ["売上高 ÷ 総資産", "当期純利益 ÷ 総資産 × 100", "流動資産 ÷ 流動負債", "当期純利益 ÷ 自己資本 × 100"], "answerIndex": 1, "explanation": "ROA = 当期純利益 ÷ 総資産 × 100（%）。総資産を、どれだけ効率的に使って利益を出したかを示す。", "difficulty": 4, "points": 1, "source": "original", "sourceRef": "自作（ITパスポート試験 新シラバス案 Ver.0.1 の範囲に該当する一般的な基礎知識）", "contentVer": "2026.10.1", "subtopicId": "business-organization"}
{"qid": "it_passport-0908", "examId": "it_passport", "levelId": "standard", "subjectId": "business", "topicId": "organization", "prompt": "総資産が1,000万円、当期純利益が50万円のとき、ROAはいくらか。", "choices": ["50%", "10%", "0.5%", "5%"], "answerIndex": 3, "explanation": "ROA = 50 ÷ 1,000 × 100 = 5%。", "difficulty": 4, "points": 1, "source": "original", "sourceRef": "自作（ITパスポート試験 新シラバス案 Ver.0.1 の範囲に該当する一般的な基礎知識）", "contentVer": "2026.10.1", "subtopicId": "business-organization"}
